---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Harry Zhong | Data Scientist - AI & Model Risk",
  description = "Data Scientist specializing in Enterprise AI Risk, GenAI Validation, and Quantitative Credit Systems."
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://harryzhong.com" />
    <meta property="og:image" content="/profile.jpg" />

    <!-- Google Analytics (preserved from original site) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SDG552HSPC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SDG552HSPC');
    </script>
  </head>
  <body class="bg-[#090a0f] text-slate-100 min-h-screen selection:bg-sky-500/20 selection:text-sky-300">
    <slot />
  </body>
</html>
