---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Harry Zhong',
  description = 'Data Scientist specializing in Enterprise AI Risk, GenAI Validation, and Quantitative Credit Systems.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-vsc-bg text-vsc-fg">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#181818" id="meta-theme-color" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Theme Detection, Preference Storage, & Real-time Sync with System Settings -->
    <script is:inline>
      (function() {
        const mql = window.matchMedia('(prefers-color-scheme: dark)');

        function getStoredPreference() {
          try {
            return localStorage.getItem('theme');
          } catch (_) {
            return null;
          }
        }

        function getEffectiveTheme() {
          const pref = getStoredPreference();
          if (pref === 'dark' || pref === 'light') {
            return pref;
          }
          return mql.matches ? 'dark' : 'light';
        }

        function applyTheme() {
          const effective = getEffectiveTheme();
          const root = document.documentElement;
          if (effective === 'dark') {
            root.classList.add('dark');
            root.classList.remove('light');
          } else {
            root.classList.add('light');
            root.classList.remove('dark');
          }
          const meta = document.getElementById('meta-theme-color');
          if (meta) {
            meta.setAttribute('content', effective === 'dark' ? '#181818' : '#f8f8f8');
          }
        }

        applyTheme();

        function onSystemChange() {
          const pref = getStoredPreference();
          if (!pref || pref === 'system') {
            applyTheme();
            window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: 'system' } }));
          }
        }

        try {
          mql.addEventListener('change', onSystemChange);
        } catch (_) {
          mql.addListener(onSystemChange);
        }

        window.__setTheme = function(theme) {
          try {
            if (theme === 'system') {
              localStorage.removeItem('theme');
            } else {
              localStorage.setItem('theme', theme);
            }
          } catch (_) {}
          applyTheme();
          window.dispatchEvent(new CustomEvent('theme-changed', { detail: { theme: theme } }));
        };

        window.__getTheme = function() {
          return getStoredPreference() || 'system';
        };
      })();
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href="https://harryzhong.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://harryzhong.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://harryzhong.com/profile.jpg" />
    <meta property="og:site_name" content="Harry Zhong" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://harryzhong.com" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://harryzhong.com/profile.jpg" />

    <!-- Google Analytics (preserved from original site) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-SDG552HSPC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-SDG552HSPC');
    </script>
  </head>
  <body class="bg-vsc-bg text-vsc-fg min-h-screen flex flex-col selection:bg-vsc-blue selection:text-white transition-colors duration-150">
    <slot />
  </body>
</html>
