---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CareerConsole from '../components/CareerConsole.tsx';
---

<Layout>
  <Header />

  <main class="flex-1 flex flex-col justify-center max-w-5xl w-full mx-auto px-4 sm:px-6 py-6 sm:py-8 min-h-[calc(100vh-3.5rem)]">
    <!-- Centerpiece: The Interactive Database Terminal -->
    <section class="w-full">
      <CareerConsole client:load />
    </section>
  </main>
</Layout>
